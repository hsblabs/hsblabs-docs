{
  "name": "hsblabs-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync": "bun scripts/sync-projects.ts",
    "content:prepare": "bun scripts/prepare-content.ts",
    "extras:generate": "bun scripts/generate-extras.ts",
    "schema:generate": "bun run extras:generate",
    "prepare:all": "bun run sync && bun run content:prepare && bun run extras:generate",
    "dev": "bun run prepare:all && astro dev",
    "build": "bun run prepare:all && astro build && bun scripts/finalize-cloudflare-assets.ts && bun scripts/verify-build.ts",
    "preview": "astro preview",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix --deny-warnings",
    "test": "vitest run",
    "self-check": "bun scripts/artifact-self-check.mjs",
    "check": "bun run format:check && bun run lint && bun run extras:generate && bun run test && bun run self-check",
    "deploy": "bun run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/starlight": "0.41.7",
    "astro": "7.2.2",
    "starlight-llms-txt": "0.11.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wrangler": "4.123.0"
  },
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=22.0.0"
  },
  "packageManager": "bun@1.3.14"
}
